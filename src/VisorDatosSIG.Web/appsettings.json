{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Backend": {
    "Url": "http://localhost:5080/"
  },
  "Seguridad": {
    "MinutosInactividad": 20,
    "RutaClaves": ""
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "backend",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/{**resto}" }
      }
    },
    "Clusters": {
      "backend": {
        "Destinations": {
          "principal": { "Address": "http://localhost:5080/" }
        }
      }
    }
  }
}
