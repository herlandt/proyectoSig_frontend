@{
    ViewData["Title"] = "Dashboard técnico";
    ViewData["Seccion"] = "Dashboard";
}
<div class="contenido-pagina" id="dashboardTecnico">
    <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
        <div>
            <p class="eyebrow">Operaciones de campo</p>
            <h1 class="titulo-pagina mb-1">Dashboard técnico</h1>
            <p class="text-body-secondary small mb-0">Avance de cortes y reconexiones asignados al personal.</p>
        </div>
        <form class="d-flex align-items-end gap-2 ms-sm-auto" id="formDia" novalidate>
            <div>
                <label class="form-label small mb-1" for="dia">Día</label>
                <input class="form-control" type="date" id="dia" />
            </div>
            <button class="btn btn-primario" type="submit"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Actualizar</button>
        </form>
    </div>

    <div class="row g-3 mb-4 row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-5" id="kpisOperativos" aria-label="Indicadores operativos">
        <div class="col"><div class="kpi"><div class="etiqueta">Cargando…</div></div></div>
    </div>

    <section class="panel p-3 p-md-4" aria-labelledby="tituloTrabajadores">
        <h2 class="h5 mb-1" id="tituloTrabajadores">Avance por trabajador</h2>
        <p class="small text-body-secondary">Realizadas, observadas y fuera del radio corresponden al día elegido; pendientes son las de las rutas activas.</p>
        <div id="tablaTrabajadores"><div class="estado-vacio">Cargando…</div></div>
    </section>
</div>

@section Scripts {
    <script src="~/js/dashboard-tecnico.js" asp-append-version="true"></script>
}
