@{
    ViewData["Title"] = "Bitácora del sistema";
    ViewData["Seccion"] = "Administración";
}
<div class="contenido-pagina" data-seccion="bitacora">
    <h1 class="titulo-pagina">Bitácora del sistema</h1>
    <section class="panel p-3 p-md-4">
        <form class="row g-2 mb-3" id="formBitacora" role="search">
            <div class="col-12 col-sm-8 col-md-6">
                <label class="form-label" for="textoBitacora">Buscar por usuario, evento o detalle</label>
                <input class="form-control" id="textoBitacora" maxlength="50" />
            </div>
            <div class="col-12 col-sm-4 col-md-2 d-flex align-items-end">
                <button class="btn btn-primario w-100" type="submit"><i class="bi bi-search me-1" aria-hidden="true"></i>Buscar</button>
            </div>
        </form>
        <div id="tablaBitacora" aria-live="polite"><div class="estado-vacio"><span class="spinner-border spinner-border-sm me-2"></span>Cargando…</div></div>
    </section>
</div>

@section Scripts {
    <script src="~/js/administracion.js" asp-append-version="true"></script>
}
