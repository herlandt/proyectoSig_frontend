@{
    ViewData["Title"] = "Cerrar sesión";
    ViewData["Seccion"] = "Cuenta";
}
<div class="contenido-pagina" style="max-width: 560px">
    <h1 class="titulo-pagina">Cerrar sesión</h1>
    <div class="panel p-4">
        <p>¿Desea finalizar la sesión y volver a la pantalla de acceso?</p>
        <div class="d-flex gap-2">
            <button class="btn btn-danger" type="button" data-accion="salir"><i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>Cerrar sesión</button>
            <a class="btn btn-outline-secondary" href="/">Cancelar</a>
        </div>
    </div>
</div>
