@{
    Layout = "_LayoutAcceso";
    ViewData["Title"] = "Iniciar sesión";
}
<div class="tarjeta-acceso card shadow-sm">
    <div class="card-body p-4 p-sm-5">
        <div class="text-center mb-4">
            <div class="logo-acceso mx-auto mb-3" aria-hidden="true"><i class="bi bi-geo-alt-fill"></i></div>
            <h1 class="h3 fw-bold mb-1">VisorDatosSIG</h1>
            <p class="text-body-secondary mb-0">Sistema web de consulta de datos geográficos</p>
            <p class="small text-body-secondary">UAGRM · FICCT · Sistemas de Información Geográfica</p>
        </div>

        <div id="mensajeAcceso" class="alert d-none" role="alert"></div>

        <form id="formAcceso" novalidate data-return-url="@ViewData["ReturnUrl"]">
            <div class="mb-3">
                <label for="login" class="form-label">Usuario</label>
                <input type="text" class="form-control form-control-lg" id="login" name="login" autocomplete="username"
                       maxlength="50" required aria-describedby="loginError" />
                <div id="loginError" class="invalid-feedback">Ingrese su usuario.</div>
            </div>
            <div class="mb-4">
                <label for="contrasena" class="form-label">Contraseña</label>
                <div class="input-group input-group-lg has-validation">
                    <input type="password" class="form-control" id="contrasena" name="contrasena" autocomplete="current-password"
                           maxlength="128" required aria-describedby="contrasenaError" />
                    <button class="btn btn-outline-secondary" type="button" id="verContrasena" aria-label="Mostrar contraseña" aria-pressed="false">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                    <div id="contrasenaError" class="invalid-feedback">Ingrese su contraseña.</div>
                </div>
            </div>
            <button type="submit" class="btn btn-primario btn-lg w-100" id="btnIngresar">
                <span class="spinner-border spinner-border-sm me-2 d-none" aria-hidden="true"></span>Ingresar
            </button>
        </form>

        @* Solo se muestra si la API está en Development con Demo:Habilitado (acceso.js lo consulta). *@
        <section id="accesoDemo" class="d-none mt-4 pt-3 border-top" aria-labelledby="tituloDemo">
            <h2 id="tituloDemo" class="h6 text-center text-body-secondary mb-3">
                <i class="bi bi-lightning-charge me-1" aria-hidden="true"></i>Acceso rápido de demostración
            </h2>
            <div class="d-grid gap-2" id="botonesDemo"></div>
        </section>
    </div>
</div>
<p class="text-center small text-body-secondary mt-3">Santa Cruz de la Sierra, Bolivia · Gestión 2026</p>

@section Scripts {
    <script src="~/js/acceso.js" asp-append-version="true"></script>
}
